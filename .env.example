# Copy to .env and edit:  cp .env.example .env

# SteamCMD branch of app 622970:
#   shack       = Pavlov Shack live (Quest)
#   shack_beta  = Pavlov Shack release candidate
#   default / beta_server = PC VR server
STEAM_BRANCH=shack

# Game port. QUERY_PORT must be GAME_PORT + 400.
GAME_PORT=7777
QUERY_PORT=8177

# Server key from https://api-key.vankrupt.net/ (PIN from in game:
# Settings > General > Server Key Generator). Without it the server is not listed.
SERVER_KEY=

# RCON is enabled only when RCON_PASSWORD is set.
# RCON_BIND=0.0.0.0 makes it reachable from other machines.
RCON_PASSWORD=
RCON_PORT=9100
RCON_BIND=127.0.0.1

# Run SteamCMD update on every start; VALIDATE=true also verifies all files.
UPDATE_ON_START=true
VALIDATE=false
