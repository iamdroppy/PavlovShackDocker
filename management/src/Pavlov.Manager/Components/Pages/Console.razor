@page "/console"
@inject RconSession Session
@inject RconActions Rcon
@inject ServerMonitor Monitor
@inject NavigationManager Navigation

<PageTitle>Console · Shack Control</PageTitle>

<PageHeader Title="Console" Eyebrow="Raw RCON" Subtitle="Send any command the server lists in Help." />

<section class="surface overflow-hidden">
    <div class="flex items-center gap-3 border-b border-white/[0.05] bg-ink-950/40 px-4 py-3 sm:px-5">
        <span class="flex gap-1.5" aria-hidden="true">
            <span class="size-2.5 rounded-full bg-rose-400/70"></span>
            <span class="size-2.5 rounded-full bg-amber-300/70"></span>
            <span class="size-2.5 rounded-full bg-signal-400/70"></span>
        </span>
        <span class="min-w-0 flex-1 truncate font-mono text-xs text-zinc-500">rcon@@@Session.Endpoint</span>
        @if (entries.Count > 0)
        {
            <button type="button" class="btn btn-ghost btn-sm -mr-2" @onclick="entries.Clear">Clear</button>
        }
    </div>

    <form class="flex gap-2 p-3 sm:p-4" @onsubmit="SendAsync" @onsubmit:preventDefault>
        <div class="relative flex-1">
            <span class="pointer-events-none absolute inset-y-0 left-4 grid place-items-center font-mono text-signal-400">›</span>
            <input class="field pl-9 font-mono text-sm" list="rcon-commands" placeholder="ServerInfo" @bind="line" @bind:event="oninput" @onkeydown="OnKeyDown"
                   autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="RCON command" enterkeyhint="send" />
            <datalist id="rcon-commands">
                @foreach (var signature in help)
                {
                    <option value="@CommandName(signature)">@signature</option>
                }
            </datalist>
        </div>
        <button type="submit" class="btn btn-primary btn-icon h-12 w-12" disabled="@(sending || string.IsNullOrWhiteSpace(line))" aria-label="Send">
            <Icon Name="@(sending ? "refresh" : "send")" Class="@(sending ? "size-[1.1rem] animate-spin" : "size-[1.1rem]")" StrokeWidth="2" />
        </button>
    </form>

    @if (Suggestions.Count > 0)
    {
        <div class="-mt-1 flex gap-1.5 overflow-x-auto px-3 pb-3 scrollbar-none sm:px-4">
            @foreach (var signature in Suggestions)
            {
                <button type="button" class="chip shrink-0 cursor-pointer font-mono font-medium hover:bg-white/10" @onclick="() => Pick(signature)">
                    <span class="text-zinc-100">@CommandName(signature)</span>
                    <span class="text-zinc-500">@ArgumentsOf(signature)</span>
                </button>
            }
        </div>
    }

    <div class="border-t border-white/[0.05]">
        @if (entries.Count == 0)
        {
            <EmptyState IconName="console" Title="Ready for commands" Message="Try ServerInfo, MapList or ItemList. Newest replies appear at the top." />
        }
        else
        {
            <ol class="divide-y divide-white/[0.04]">
                @foreach (var entry in entries)
                {
                    <li @key="entry" class="animate-rise px-4 py-4 sm:px-5">
                        <div class="flex items-center gap-2 font-mono text-[0.8rem]">
                            <span class="text-signal-400">›</span>
                            <span class="min-w-0 flex-1 truncate text-zinc-100">@entry.Line</span>
                            <span class="@($"chip h-6 px-2 text-[0.62rem] {(entry.Ok ? "bg-signal-400/10 text-signal-300 ring-signal-400/20" : "bg-rose-500/10 text-rose-300 ring-rose-400/20")}")">@(entry.Ok ? "OK" : "FAILED")</span>
                            <time class="text-[0.68rem] text-zinc-600">@entry.At.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</time>
                        </div>
                        <pre class="mt-2.5 max-h-96 overflow-auto rounded-2xl bg-ink-950/70 p-3.5 font-mono text-[0.75rem] leading-relaxed text-zinc-400 ring-1 ring-white/[0.04]">@if (entry.IsJson)
                        {
                            @JsonHighlighter.Highlight(entry.Output)
                        }
                        else
                        {
                            @entry.Output
                        }</pre>
                    </li>
                }
            </ol>
        }
    </div>
</section>

@code {
    private sealed record ConsoleEntry(DateTimeOffset At, string Line, bool Ok, string Output, bool IsJson);

    private static readonly HashSet<string> Blocked = new(StringComparer.OrdinalIgnoreCase) { "Disconnect" };

    private readonly List<ConsoleEntry> entries = [];
    private readonly List<string> history = [];
    private IReadOnlyList<string> help = [];
    private HashSet<string> known = new(StringComparer.OrdinalIgnoreCase);
    private string line = "";
    private bool sending;
    private int historyIndex = -1;

    private List<string> Suggestions
    {
        get
        {
            var prefix = line.Trim().Split(' ', 2)[0];
            return
            [
                .. help.Where(s => !Blocked.Contains(CommandName(s)))
                    .Where(s => prefix.Length == 0 || s.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                    .Take(prefix.Length == 0 ? 12 : 8),
            ];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        help = await Rcon.QueryAsync(c => c.GetHelpAsync(), []);
        known = new HashSet<string>(help.Select(CommandName), StringComparer.OrdinalIgnoreCase) { "Help" };
    }

    private static string CommandName(string signature) => signature.Split(' ', 2)[0];

    private static string ArgumentsOf(string signature) => signature.Split(' ', 2) is [_, var rest] ? rest : "";

    private void Pick(string signature)
    {
        var name = CommandName(signature);
        line = ArgumentsOf(signature).Length > 0 ? name + " " : name;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (history.Count == 0 || e.Key is not ("ArrowUp" or "ArrowDown"))
        {
            return;
        }

        historyIndex = e.Key == "ArrowUp"
            ? Math.Min(historyIndex + 1, history.Count - 1)
            : Math.Max(historyIndex - 1, -1);
        line = historyIndex < 0 ? "" : history[history.Count - 1 - historyIndex];
    }

    private async Task SendAsync()
    {
        RconCommand command;
        try
        {
            command = RconCommand.Parse(line);
        }
        catch (ArgumentException ex)
        {
            Add(line.Trim(), false, ex.Message.Split(" (Parameter", 2)[0], false);
            return;
        }

        var text = command.ToString();
        if (Blocked.Contains(command.Name))
        {
            Add(text, false, "Disconnect would close the manager's shared connection, so it's blocked here.", false);
            return;
        }

        if (known.Count > 0 && !known.Contains(command.Name))
        {
            Add(text, false, $"'{command.Name}' isn't in the server's Help list. The server ignores unknown commands without replying.", false);
            return;
        }

        sending = true;
        history.Remove(text);
        history.Add(text);
        historyIndex = -1;
        line = "";
        try
        {
            var response = await Session.Client.ExecuteAsync(command);
            Add(text, response.Successful, response.ToDisplayString(), response.Json is not null);
            Monitor.RequestRefresh();
        }
        catch (RconSessionExpiredException)
        {
            Navigation.NavigateTo("login?expired=1", forceLoad: true);
        }
        catch (RconException ex)
        {
            Add(text, false, ex.Message, false);
        }
        finally
        {
            sending = false;
        }
    }

    private void Add(string commandLine, bool ok, string output, bool isJson)
    {
        entries.Insert(0, new ConsoleEntry(DateTimeOffset.UtcNow, commandLine, ok, output, isJson));
        if (entries.Count > 100)
        {
            entries.RemoveAt(entries.Count - 1);
        }
    }
}
