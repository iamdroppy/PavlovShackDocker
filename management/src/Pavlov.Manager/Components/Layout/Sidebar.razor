@inherits LiveComponent

<aside class="fixed inset-y-0 left-0 z-40 hidden w-72 flex-col border-r border-white/[0.05] bg-ink-950/60 px-5 py-6 backdrop-blur-2xl lg:flex">
    <a href="" class="flex items-center gap-3 px-2">
        <BrandMark Class="size-10" />
        <span class="leading-tight">
            <span class="block text-[0.95rem] font-semibold tracking-tight text-zinc-50">Shack Control</span>
            <span class="eyebrow !tracking-[0.14em]">Pavlov server manager</span>
        </span>
    </a>

    <nav class="mt-10 flex flex-col gap-1" aria-label="Main">
        <p class="eyebrow mb-2 px-3">Manage</p>
        @foreach (var item in NavItems.All)
        {
            <NavLink href="@item.Href" Match="item.Match" class="side-link group flex h-11 items-center gap-3 rounded-2xl px-3 text-sm font-medium text-zinc-400 transition hover:bg-white/[0.04] hover:text-zinc-100">
                <Icon Name="@item.Icon" Class="size-[1.15rem] transition group-hover:text-zinc-200" />
                <span class="flex-1">@item.Label</span>
                @if (item.Href == "players" && Snapshot.Players.Count > 0)
                {
                    <span class="rounded-full bg-signal-400/12 px-2 py-0.5 text-[0.7rem] font-semibold text-signal-400 tabular-nums">@Snapshot.Players.Count</span>
                }
            </NavLink>
        }
    </nav>

    <div class="mt-auto">
        @if (Snapshot.Info is { } info)
        {
            <div class="surface relative overflow-hidden p-4">
                <div aria-hidden="true" class="absolute -top-10 -right-10 size-32 rounded-full bg-signal-400/10 blur-2xl"></div>
                <p class="eyebrow flex items-center gap-2"><StatusDot Online="Snapshot.IsOnline" Class="scale-75" /> Now playing</p>
                <p class="mt-3 truncate text-lg font-semibold tracking-tight text-zinc-50">@info.DisplayMap</p>
                <p class="truncate text-xs text-zinc-400">@PavlovCatalog.GameModeName(info.GameMode)</p>
                <div class="mt-4 flex items-center justify-between text-xs text-zinc-400">
                    <span>Players</span>
                    <span class="font-semibold text-zinc-200 tabular-nums">@info.CurrentPlayers / @info.MaxPlayers</span>
                </div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/[0.06]">
                    <div class="h-full rounded-full bg-signal-400 transition-[width] duration-700" style="width: @Fill(info)%"></div>
                </div>
            </div>
        }

        <form method="post" action="logout" class="mt-3">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-ghost h-11 w-full justify-start gap-3 px-3 font-medium">
                <Icon Name="logout" Class="size-[1.15rem]" />
                Sign out
            </button>
        </form>
    </div>
</aside>

@code {
    private static string Fill(ServerInfo info) =>
        info.MaxPlayers == 0 ? "0" : Math.Clamp(info.CurrentPlayers * 100.0 / info.MaxPlayers, 0, 100).ToString("0.#", CultureInfo.InvariantCulture);
}
