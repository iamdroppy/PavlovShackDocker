@implements IDisposable
@inject DialogService Dialogs

@if (Dialogs.Current is { } request)
{
    <div class="fixed inset-0 z-[65] flex items-end justify-center p-3 sm:items-center sm:p-6" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
        <button type="button" class="absolute inset-0 animate-fade-in cursor-default bg-ink-950/80 backdrop-blur-sm" aria-label="Cancel" @onclick="() => Dialogs.Close(false)"></button>
        <div class="relative w-full max-w-sm animate-pop-in rounded-[2rem] border border-white/[0.08] bg-ink-850 p-6 shadow-2xl shadow-black">
            <span class="@($"grid size-12 place-items-center rounded-2xl {(request.Danger ? "bg-rose-500/15 text-rose-300" : "bg-signal-400/12 text-signal-400")}")">
                <Icon Name="@(request.Danger ? "alert" : "info")" Class="size-6" />
            </span>
            <h2 id="confirm-title" class="mt-5 text-lg font-semibold tracking-tight text-zinc-50">@request.Title</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">@request.Message</p>
            <div class="mt-6 grid grid-cols-2 gap-2.5">
                <button type="button" class="btn btn-soft" @onclick="() => Dialogs.Close(false)">Cancel</button>
                <button type="button" class="@($"btn {(request.Danger ? "bg-rose-500 text-white hover:bg-rose-400" : "btn-primary")}")" @onclick="() => Dialogs.Close(true)">@request.ConfirmText</button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Dialogs.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Dialogs.Changed -= OnChanged;
}
