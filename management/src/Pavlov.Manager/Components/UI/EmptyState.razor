<div class="@($"flex flex-col items-center px-6 py-14 text-center {Class}")">
    <span class="relative grid size-16 place-items-center rounded-3xl bg-white/[0.04] text-zinc-400 ring-1 ring-white/[0.07]">
        <span class="absolute inset-0 rounded-3xl bg-[radial-gradient(circle_at_50%_0%,rgba(212,255,58,0.18),transparent_70%)]"></span>
        <Icon Name="@IconName" Class="relative size-7" StrokeWidth="1.5" />
    </span>
    <p class="mt-5 text-base font-semibold text-zinc-100">@Title</p>
    @if (Message is not null)
    {
        <p class="mt-1.5 max-w-xs text-sm leading-relaxed text-zinc-500">@Message</p>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string IconName { get; set; } = "info";

    [Parameter] public string Title { get; set; } = "";

    [Parameter] public string? Message { get; set; }

    [Parameter] public string Class { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
