<header class="mb-6 flex flex-wrap items-end justify-between gap-4 sm:mb-8">
    <div class="min-w-0">
        @if (Eyebrow is not null)
        {
            <p class="eyebrow mb-2">@Eyebrow</p>
        }
        <h1 class="text-[1.9rem] leading-none font-semibold tracking-[-0.03em] text-zinc-50 sm:text-4xl" tabindex="-1">@Title</h1>
        @if (Subtitle is not null)
        {
            <p class="mt-2.5 text-sm text-zinc-400">@Subtitle</p>
        }
    </div>
    @Actions
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Eyebrow { get; set; }

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
}
